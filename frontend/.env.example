# --- CONSOL API (Laravel) -------------------------------------------------
# Local development. The Laravel backend is a separate project; this frontend
# only ever talks to it over HTTP and never holds database credentials.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Presentation mode: when the API is not reachable the UI falls back to the
# clearly-labelled demonstration content in src/data. Never "true" in production
# once Laravel endpoints are implemented and tested.
VITE_ENABLE_DEMO_DATA=true

# Production example (set in the hosting dashboard, not committed):
# VITE_API_BASE_URL=https://api.constructionsolutionsplc.com/api

# Optional assistant gateway. ONLY the public endpoint of the Laravel backend —
# never an AI provider key. Provider keys stay on the server.
# VITE_ASSISTANT_ENDPOINT=/assistant/chat
