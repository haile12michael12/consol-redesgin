# --- CONSOL API (Laravel) -------------------------------------------------
# Local development. The Laravel backend is a separate project; this frontend
# only ever talks to it over HTTP and never holds database credentials.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional presentation fallback for local development only. Production builds
# always disable demo data, even if this variable is accidentally set to true.
VITE_ENABLE_DEMO_DATA=false

# Production example (set in the hosting dashboard, not committed):
# VITE_API_BASE_URL=https://api.constructionsolutionsplc.com/api
